# Written for Python 3.15: PEP 810's lazy import is a SyntaxError on every
# Python Towel supports, as a PEP 701 f-string is on 3.11.
lazy import json

from unittest import mock

from pkg.b import describe_b


def test_patched_len():
    with mock.patch("pkg.b.len", create=True, return_value=100):
        result = describe_b([1, 2, 3])
    assert result == "n=200"


if __name__ == "__main__":
    test_patched_len()
    print("patched")
