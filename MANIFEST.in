include LICENSE README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md justfile .flake8 .pre-commit-config.yaml uv.lock
recursive-include src *.py
recursive-include tests *.py *.md
recursive-include test_examples *.py *.md
recursive-include test_examples_expected_output *.py
recursive-include test_examples_crossfile *.py *.md
recursive-include test_examples_crossfile_expected_output *.py
recursive-include scripts *
exclude scripts/_debug_global_case.py scripts/debug_pair.py
prune .templates
recursive-include docs *.md
prune docs/docs_local
prune .todo
prune .claude
prune .vscode
global-exclude __pycache__ *.py[cod] .env .DS_Store
